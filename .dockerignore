.ruff_cache
media
staticfiles
models
node_modules
test-results
.idea
.codex
.coverage*
.aws
.agents
.vscode
*.sqlite3
*.sqlite3-*
*.log
source.tar.gz

.reference
.migration.py
.frontend_move.py
.config_edit.py
.build_edit.py

legacy
