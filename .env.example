# Пример приватного файла .env. При первой установке запустите watch.sh init.
# init задаёт APP_ENV=production и четыре уникальных секрета.
APP_ENV=production
DJANGO_SECRET_KEY=
CAMERA_CREDENTIALS_KEY=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# Добавляйте только параметры, которые отличаются от defaults в src/core/config.py.
# Для HTTPS proxy: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,watch.example.org
# Для HTTPS proxy: DJANGO_CSRF_TRUSTED_ORIGINS=https://watch.example.org
# При другой инфраструктуре: SHARED_NETWORK=ai-shared
# При другом имени RabbitMQ: RABBITMQ_HOST=rabbitmq
# При другом bind: WEB_BIND_IP=127.0.0.1
# При другом порте: WEB_PORT=8086
# Для vision на GPU: VISION_ENABLED=true, VISION_DEVICE=0, VISION_GPU_ID=0
# Для другого файла весов: VISION_MODEL=models/yolo11n.pt
# Для импорта камер: CAMERA_INDICES=1,2 и CAMERA_1_*, CAMERA_2_*.
# Для внешних уведомлений: NOTIFICATIONS_ENABLED=true и параметры SMTP/Telegram.
