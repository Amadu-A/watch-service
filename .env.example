# .env.example
# Безопасный baseline проекта. Реальные секреты хранятся только в .env.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false

DATABASE_ENGINE=sqlite
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=warehouse_watch
POSTGRES_USER=warehouse_watch
POSTGRES_PASSWORD=

REDIS_URL=redis://redis:6379/0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=warehouse-watch
RABBITMQ_USER=warehouse-watch
RABBITMQ_PASSWORD=

SHARED_NETWORK=ai-shared
WEB_BIND_IP=127.0.0.1
WEB_PORT=8086

CAMERA_CREDENTIALS_KEY=

# Первичный импорт камер; фиктивные адреса не являются реальными.
CAMERA_INDICES=1,2
CAMERA_1_NAME=Главный вход
CAMERA_1_IP=192.0.2.10
CAMERA_1_PORT=554
CAMERA_1_PATH=/stream1
CAMERA_1_USERNAME=
CAMERA_1_PASSWORD=

CAMERA_2_NAME=Боковой вход
CAMERA_2_IP=192.0.2.11
CAMERA_2_PORT=554
CAMERA_2_PATH=/stream1
CAMERA_2_USERNAME=
CAMERA_2_PASSWORD=

DEFAULT_TIMEZONE=Europe/Moscow
MEDIA_RETENTION_DAYS=30
MEDIA_ROOT=media
MONITORING_MAX_VISIBLE_CAMERAS=16

NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
TELEGRAM_BOT_TOKEN=

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TIMEOUT_SECONDS=15

VISION_ENABLED=true
VISION_DEVICE=cpu
VISION_GPU_ID=0
VISION_MODEL=models/yolo11n.pt
VISION_FPS=5
VISION_FRAME_TTL_SECONDS=10
VISION_TRACK_TTL_SECONDS=30
VISION_MIN_TRACK_FRAMES=3
VISION_STABLE_FRAMES=2
VISION_HYSTERESIS=0.02
VISION_RECONNECT_MAX_SECONDS=60

EVIDENCE_BEFORE_SECONDS=1
EVIDENCE_AFTER_SECONDS=1

EVENT_CLIP_ENABLED=false
CLIP_BEFORE_SECONDS=5
CLIP_AFTER_SECONDS=5

REPORT_FONT_PATH=
LOG_LEVEL=INFO